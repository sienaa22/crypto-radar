# Copy to /opt/radar/radar.env (mode 600, owner radar) and fill in your values.
# Every setting except the tokens is optional; the defaults are shown.

# --- Shared --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Project Radar (radar.py) ----------------------------------------------
# Fine-grained token with public read access is enough
GITHUB_TOKEN=
RADAR_DB=/opt/radar/radar.db
# GitHub answers are cached with ETags, so 15 minutes costs little
RADAR_INTERVAL_SECONDS=900
# Daily status report for all four services
RADAR_STATUS_HOUR_UTC=8

# --- Whale Watch (whales.py) -----------------------------------------------
HL_DB=/opt/radar/whales.db
HL_EXTRA_ADDRESSES_FILE=/opt/radar/extra_whales.txt
HL_BIG_TRADE_USD=1000000
HL_LIQ_MIN_USD=500000
HL_LIQ_WARN_PCT=2.0
# Big trades rated below this are logged but not sent: LOW, MEDIUM or HIGH
HL_MIN_QUALITY=MEDIUM
HL_WHALE_COUNT=150
# 30-day volume / account value above this = market maker, left out of the whale list
HL_MM_MAX_TURNOVER=50
HL_SMART_CANDIDATES=200
HL_SMART_MIN_ACCOUNT_USD=100000
HL_SMART_MAX=30
HL_SMART_MIN_TRADES=50
HL_SMART_MIN_PF=1.5
HL_SMART_MIN_GOOD_MONTHS=3
HL_SMART_MAX_FILLS_PER_DAY=150
HL_CONSENSUS_MIN_TRADERS=5
HL_CONSENSUS_MIN_RATIO=0.7
HL_FRESH_INCREASE=1.5
HL_ACC_WINDOW_HOURS=48
HL_ACC_MIN_GROWTH_USD=750000
HL_ACC_MIN_RATIO=2.0
HL_ACC_COOLDOWN_HOURS=48
HL_SCAN_SECONDS=120
HL_REFRESH_HOURS=24
HL_DAILY_SUMMARY_HOUR_UTC=6
# Parallel position reads per cycle
HL_WORKERS=4

# --- Heat Analyzer (heat.py) -----------------------------------------------
HEAT_DB=/opt/radar/heat.db
HEAT_MIN_MCAP=25000000
HEAT_MIN_FEES_30D=100000
HEAT_MIN_RETENTION=0.05
HEAT_MIN_FEE_ACCEL=1.3
HEAT_MIN_MOMENTUM_7D=0.9
HEAT_MIN_GAP=20
HEAT_TOP_N=12
HEAT_DAILY_HOUR_UTC=7

# --- Attention Radar (attention.py) ----------------------------------------
ATT_DB=/opt/radar/attention.db
# Optional CoinGecko demo key
COINGECKO_API_KEY=
ATT_MARKETS_PAGES=2
ATT_TOP_N=15
ATT_W_TRENDING=3.0
ATT_W_VOL_SPIKE=2.0
ATT_W_PRICE_24H=1.0
ATT_W_OI_JUMP=2.0
ATT_W_FUNDING=1.0
ATT_W_CONSENSUS=3.0
ATT_W_HEAT=2.0
ATT_VOL_MCAP_HOT=0.15
ATT_PRICE_24H_HOT=10.0
ATT_FUNDING_HOT=0.0003
ATT_OI_CHANGE_HOT=30.0
ATT_OI_MIN_USD=1000000
ATT_DAILY_HOUR_UTC=6

# --- News Watch (news.py) --------------------------------------------------
NEWS_DB=/opt/radar/news.db
NEWS_INTERVAL_SECONDS=600
# Headlines scoring at least this are sent (hack 4, ETF decision 4, listing 3,
# unlock 2, a top-100 coin named 2, another outlet with the same story +1 ...)
NEWS_MIN_SCORE=4
NEWS_HACK_MIN_USD=1000000
# Cliff unlocks: at least this % of unlocked supply and this USD value
NEWS_UNLOCK_MIN_PCT=1.0
NEWS_UNLOCK_MIN_USD=5000000
# Only tokens whose unlocked supply is worth at least this
NEWS_UNLOCK_MIN_MCAP=100000000
# Alert when investor and team vesting ends within this many days (and again on the day)
NEWS_VESTING_END_DAYS=14
# Unlock schedules downloaded per cycle (each about 1 MB, refreshed weekly)
NEWS_UNLOCK_FETCH_PER_CYCLE=6

# --- Flow Watch (flows.py) -------------------------------------------------
FLOWS_DB=/opt/radar/flows.db
FLOWS_INTERVAL_SECONDS=300
# Binance USDT perps checked, by 24h volume
FLOWS_TOP_PERPS=120
# Open interest jump within 4 hours, and the minimum position size to care about
FLOWS_OI_JUMP_PCT=20
FLOWS_OI_MIN_USD=20000000
# Funding per 8h counted as crowded (0.001 = 0.1%)
FLOWS_FUNDING_EXTREME=0.001
# Top traders long/short at least this while all accounts are at most the other
FLOWS_TOP_LONG_RATIO=1.5
FLOWS_CROWD_SHORT_RATIO=0.9
# Net USDT+USDC supply change in 24h worth an alert
FLOWS_STABLE_MOVE_USD=500000000

# --- Signal Hub (brain.py) -------------------------------------------------
BRAIN_DB=/opt/radar/brain.db
# Shared ledger every service writes its signals to
SIGNALS_DB=/opt/radar/signals.db
# A convergence needs this many signals from this many services within the window
BRAIN_WINDOW_HOURS=48
BRAIN_MIN_SIGNALS=3
BRAIN_MIN_SERVICES=2
# Weekly scorecard: weekday (0 = Monday) and hour UTC
BRAIN_SCORECARD_WEEKDAY=0
BRAIN_SCORECARD_HOUR_UTC=8

# --- AI summaries (optional, ai.py) ------------------------------------------
# Needs: sudo pip3 install anthropic. Leave the key empty to keep AI off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_CALLS_PER_DAY=60
